/var/log/rtorrent/*.log {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    maxsize 100M
    # /var/log/rtorrent is owned by the rTorrent user
    su __USERNAME__ __USERNAME__
    # rTorrent keeps the log open and does not reopen it on a signal,
    # so truncate in place instead of moving the file away.
    copytruncate
}
